DATABASE_URL="postgresql://user:password@localhost:5432/mobility?schema=public"

# Authentication foundation. JWT_SECRET must contain at least 32 random bytes.
# Never commit a real secret. Generate and inject it through the runtime secret store.
JWT_SECRET=""
JWT_ISSUER="mobility-platform-backend"
JWT_AUDIENCE="mobility-platform-clients"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

NODE_ENV="development"

# Google Places (New) — server-side operational base validation (Decision B).
# When PLACES_VALIDATION_ENABLED=true and GOOGLE_PLACES_API_KEY is set,
# providerPlaceId is the authoritative source of coordinates on ride creation.
# Leave unset to keep the dev/test pass-through behavior.
# PLACES_VALIDATION_ENABLED="false"
# GOOGLE_PLACES_API_KEY=""
# GOOGLE_PLACES_BASE_URL="https://places.googleapis.com/v1/places"
# GOOGLE_PLACES_FIELD_MASK="id,displayName,formattedAddress,location"
# PLACES_COORDINATE_TOLERANCE_KM="0.5"
# PLACES_REQUEST_TIMEOUT_MS="8000"
# GOOGLE_MAPS_SERVER_API_KEY=""
# CURRENT_LOCATION_FRESHNESS_MS="300000"

# PicPay Configuration
PICPAY_ENVIRONMENT="production"
PICPAY_CLIENT_ID=""
PICPAY_CLIENT_SECRET=""
PICPAY_SELLER_CNPJ=""
PICPAY_PIX_KEY=""
PICPAY_API_URL="https://api.picpay.com"
SETTLEMENT_PROVIDER="picpay"

# RideQuote (Fase D) — vida útil do contrato de precificação em ms-equivalent
# duration ("15m" = 15 minutos). expiresAt = createdAt + RIDE_QUOTE_TTL.
RIDE_QUOTE_TTL="15m"
