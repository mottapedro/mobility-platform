DATABASE_URL="postgresql://user:password@localhost:5432/mobility?schema=public"

# Authentication foundation. JWT_SECRET must contain at least 32 random bytes.
# Never commit a real secret. Generate and inject it through the runtime secret store.
JWT_SECRET=""
JWT_ISSUER="mobility-platform-backend"
JWT_AUDIENCE="mobility-platform-clients"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

NODE_ENV="development"

# PicPay Configuration
PICPAY_ENVIRONMENT="production"
PICPAY_CLIENT_ID=""
PICPAY_CLIENT_SECRET=""
PICPAY_SELLER_CNPJ=""
PICPAY_PIX_KEY=""
PICPAY_API_URL="https://api.picpay.com"
SETTLEMENT_PROVIDER="picpay"
