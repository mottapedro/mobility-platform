{
  "name": "mobility-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "seed:base": "ts-node -r tsconfig-paths/register prisma/seeds/base-seed.ts",
    "seed:dev": "ts-node -r tsconfig-paths/register prisma/seeds/dev-fixtures.ts",
    "bootstrap:network": "ts-node -r tsconfig-paths/register scripts/network/bootstrap-network.ts",
    "backfill:driver-network": "ts-node -r tsconfig-paths/register scripts/network/backfill-driver-network.ts",
    "backfill:passenger-network": "ts-node -r tsconfig-paths/register scripts/passenger/backfill-passenger-network.ts",
    "backfill:passenger-driver-links": "ts-node -r tsconfig-paths/register scripts/network/backfill-passenger-driver-links.ts",
    "seed:golden": "ts-node --transpileOnly -r tsconfig-paths/register prisma/seeds/golden-network-seed.ts",
    "seed:god-network": "npm run seed:golden",
    "backfill:referral-v2": "ts-node -r tsconfig-paths/register scripts/backfill-referral-relationships.ts",
    "backfill:skills": "ts-node -r tsconfig-paths/register scripts/backfill-gisele-skill.ts",
    "verify:network": "ts-node -r tsconfig-paths/register scripts/verify-network.ts",
    "audit:godnetwork": "ts-node -r tsconfig-paths/register scripts/network/audit-godnetwork-governance.ts",
    "postinstall": "prisma generate",
    "test": "jest --runInBand --forceExit",
    "test:contracts": "jest --runInBand --forceExit --testPathPatterns=tests/contracts/",
    "test:smoke": "jest --runInBand --forceExit --testPathPatterns=e2e/smoke/",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "pg": "^8.20.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@prisma/client": "7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prisma": "7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.2"
  }
}
