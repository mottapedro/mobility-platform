generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String
  role         UserRole
  createdAt    DateTime   @default(now())
  passwordHash String?
  driver       Driver?
  passenger    Passenger?
}

model Driver {
  id                                                     String               @id @default(uuid())
  userId                                                 String               @unique
  experienceLevel                                        ExperienceLevel
  isActive                                               Boolean              @default(true)
  createdAt                                              DateTime             @default(now())
  referralCode                                           String               @unique @default(cuid())
  networkLevel                                           Int                  @default(0)
  referredByDriverId                                     String?
  publicSlug                                             String?              @unique
  regions                                                String[]
  referredBy                                             Driver?              @relation("DriverDirectReferral", fields: [referredByDriverId], references: [id])
  referredDrivers                                        Driver[]             @relation("DriverDirectReferral")
  user                                                   User                 @relation(fields: [userId], references: [id])
  availability                                           DriverAvailability[]
  referralsReceived                                      DriverReferral[]     @relation("Referred")
  DriverReferral_DriverReferral_referrerDriverIdToDriver DriverReferral[]     @relation("DriverReferral_referrerDriverIdToDriver")
  DriverRegion                                           DriverRegion[]
  referredPassengers                                     Passenger[]          @relation("DriverReferral")
  offers                                                 RideOffer[]
  selectedRides                                          RideRequest[]
  vehicles                                               Vehicle[]

  @@index([networkLevel])
  @@index([referredByDriverId])
}

model Passenger {
  id                 String        @id @default(uuid())
  userId             String        @unique
  referredByDriverId String?
  referredByDriver   Driver?       @relation("DriverReferral", fields: [referredByDriverId], references: [id])
  user               User          @relation(fields: [userId], references: [id])
  rideRequests       RideRequest[]
}

model Vehicle {
  id        String          @id @default(uuid())
  driverId  String
  model     String
  brand     String
  plate     String          @unique
  category  VehicleCategory
  createdAt DateTime        @default(now())
  driver    Driver          @relation(fields: [driverId], references: [id])
}

model DriverAvailability {
  id        String @id @default(uuid())
  driverId  String
  dayOfWeek Int
  startTime String
  endTime   String
  driver    Driver @relation(fields: [driverId], references: [id])
}

model RideRequest {
  id               String      @id @default(uuid())
  passengerId      String
  origin           String
  destination      String
  scheduledAt      DateTime
  status           RideStatus  @default(PENDING)
  selectedDriverId String?
  createdAt        DateTime    @default(now())
  destinationLat   Float?
  destinationLng   Float?
  distanceKm       Float?
  durationMin      Int?
  originLat        Float?
  originLng        Float?
  priceEstimated   Float?
  priceOffered     Float?
  context          Json?
  offers           RideOffer[]
  passenger        Passenger   @relation(fields: [passengerId], references: [id])
  selectedDriver   Driver?     @relation(fields: [selectedDriverId], references: [id])

  @@index([scheduledAt])
}

model DriverReferral {
  id                                             String   @id @default(uuid())
  referrerDriverId                               String
  referredDriverId                               String
  level                                          Int
  createdAt                                      DateTime @default(now())
  referred                                       Driver   @relation("Referred", fields: [referredDriverId], references: [id])
  Driver_DriverReferral_referrerDriverIdToDriver Driver   @relation("DriverReferral_referrerDriverIdToDriver", fields: [referrerDriverId], references: [id])

  @@unique([referrerDriverId, referredDriverId])
  @@index([referredDriverId])
}

model RideOffer {
  id            String          @id @default(uuid())
  rideRequestId String
  driverId      String
  status        RideOfferStatus @default(PENDING)
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())
  driver        Driver          @relation(fields: [driverId], references: [id])
  rideRequest   RideRequest     @relation(fields: [rideRequestId], references: [id])

  @@unique([rideRequestId, driverId])
  @@index([driverId, status])
}



enum UserRole {
  DRIVER
  PASSENGER
}

enum ExperienceLevel {
  INICIANTE
  INTERMEDIARIO
  PROFISSIONAL
  ELITE
}

enum VehicleCategory {
  CONFORTO
  EXECUTIVO
}

enum Region {
  ZN
  ZS
  ZO
  BAIXADA
  INTER
}

enum RideStatus {
  PENDING
  MATCHING
  WAITING_DRIVER
  ACCEPTED
  REJECTED
  EXPIRED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  WAITING_REFERRAL
}

enum RideOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}
