generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DRIVER
  PASSENGER
}

enum ExperienceLevel {
  INICIANTE
  INTERMEDIARIO
  PROFISSIONAL
  ELITE
}

enum VehicleCategory {
  CONFORTO
  EXECUTIVO
}

enum Region {
  ZN
  ZS
  ZO
  BAIXADA
  INTER
}

enum RideStatus {
  PENDING
  MATCHING
  WAITING_REFERRAL
  WAITING_DRIVER
  ACCEPTED
  REJECTED
  EXPIRED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RideOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  role         UserRole
  passwordHash String?
  createdAt    DateTime @default(now())

  driver    Driver?
  passenger Passenger?
}

model Driver {
  id                 String          @id @default(uuid())
  userId             String          @unique
  referralCode       String          @unique @default(cuid())
  experienceLevel    ExperienceLevel
  isActive           Boolean         @default(true)
  networkLevel       Int             @default(0)
  referredByDriverId String?
  publicSlug         String?         @unique
  createdAt          DateTime        @default(now())
  selectedRides      RideRequest[]

  regions String[]

  user            User                 @relation(fields: [userId], references: [id])
  vehicles        Vehicle[]
  offers          RideOffer[]
  availability    DriverAvailability[]
  referredBy      Driver?              @relation("DriverDirectReferral", fields: [referredByDriverId], references: [id])
  referredDrivers Driver[]             @relation("DriverDirectReferral")

  referredPassengers Passenger[] @relation("DriverReferral")

  // Multi-level referral network via join table
  referralsMade     DriverReferral[] @relation("Referrer")
  referralsReceived DriverReferral[] @relation("Referred")
}

model Passenger {
  id                    String   @id @default(uuid())
  userId                String   @unique
  referredByDriverId    String?
  referralCode          String?  @unique
  publicSlug            String?  @unique
  referredByPassengerId String?
  networkLevel          Int      @default(0)
  rootPassengerId       String?
  lineagePath           String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                User    @relation(fields: [userId], references: [id])
  referredByDriver    Driver? @relation("DriverReferral", fields: [referredByDriverId], references: [id])
  referredByPassenger Passenger?  @relation("PassengerReferrals", fields: [referredByPassengerId], references: [id])
  referrals           Passenger[] @relation("PassengerReferrals")

  rideRequests RideRequest[]
}

model Vehicle {
  id        String          @id @default(uuid())
  driverId  String
  model     String
  brand     String
  plate     String          @unique
  category  VehicleCategory
  createdAt DateTime        @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
}

model DriverAvailability {
  id        String @id @default(uuid())
  driverId  String
  dayOfWeek Int
  startTime String
  endTime   String

  driver Driver @relation(fields: [driverId], references: [id])
}

model RideRequest {
  id          String @id @default(uuid())
  passengerId String
  origin      String
  destination String

  // 🚀 NOVOS CAMPOS (V2 READY)
  originLat      Float?
  originLng      Float?
  destinationLat Float?
  destinationLng Float?

  distanceKm  Float?
  durationMin Int?

  priceEstimated Float?
  priceOffered   Float?

  // 🎯 V1.3 — Contexto da corrida
  context Json?

  scheduledAt      DateTime
  status           RideStatus @default(PENDING)
  selectedDriverId String?
  createdAt        DateTime   @default(now())

  passenger Passenger @relation(fields: [passengerId], references: [id])

  offers RideOffer[]

  selectedDriver Driver? @relation(fields: [selectedDriverId], references: [id])

  @@index([scheduledAt])
}

model DriverReferral {
  id String @id @default(uuid())

  driverId         String
  referredDriverId String

  level Int

  createdAt DateTime @default(now())

  driver   Driver @relation("Referrer", fields: [driverId], references: [id])
  referred Driver @relation("Referred", fields: [referredDriverId], references: [id])

  @@unique([driverId, referredDriverId])
}

model RideOffer {
  id            String          @id @default(uuid())
  rideRequestId String
  driverId      String
  status        RideOfferStatus @default(PENDING)
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())

  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])
  driver      Driver      @relation(fields: [driverId], references: [id])

  @@unique([rideRequestId, driverId])
  @@index([driverId, status])
}
